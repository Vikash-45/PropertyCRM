<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Prevent unencrypted customer PII from leaking to Google Drive Auto Backup -->
        <exclude domain="database" path="property_crm_database.db" />
        <exclude domain="database" path="property_crm_database.db-wal" />
        <exclude domain="database" path="property_crm_database.db-shm" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
